POST {{baseUrl}}/v1/recaudos
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "clientId": 1,
  "fecha": "2026-10-01",
  "valor": 150000
}

### POST - Registrar recaudo sin fecha (usa hoy)
POST {{baseUrl}}/v1/recaudos
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "clientId": 1,
  "valor": 50000
}

### POST - Deberia fallar con valor <= 0 (400)
POST {{baseUrl}}/v1/recaudos
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "clientId": 1,
  "valor": -100
}

### POST - Deberia fallar con cliente inexistente (404)
POST {{baseUrl}}/v1/recaudos
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "clientId": 99999,
  "valor": 100000
}

### POST - Deberia fallar con rol user (403)
POST {{baseUrl}}/v1/recaudos
Content-Type: application/json
Authorization: Bearer {{viajeroToken}}

{
  "clientId": 1,
  "valor": 100000
}

### GET - Listar todos los recaudos (ADMIN, filtrado por clientId)
GET {{baseUrl}}/v1/recaudos?clientId=1&page=1&limit=10
Authorization: Bearer {{adminToken}}

### GET - Viajero lista solo sus recaudos (USER)
GET {{baseUrl}}/v1/recaudos
Authorization: Bearer {{viajeroToken}}

### GET - Obtener recaudo por ID (ADMIN)
GET {{baseUrl}}/v1/recaudos/1
Authorization: Bearer {{adminToken}}

### PATCH - Actualizar recaudo (ADMIN)
PATCH {{baseUrl}}/v1/recaudos/1
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "valor": 175000
}

### DELETE - Eliminar recaudo (ADMIN)
DELETE {{baseUrl}}/v1/recaudos/1
Authorization: Bearer {{adminToken}}


# ==========================================================
# 6. DASHBOARD (SOLO SUPERADMIN)
# ==========================================================

### GET - KPIs: fondo viajero, usuarios registrados, alertas de inactividad
# Dinero en Fondo Viajero = SUM(valor) de recaudos
# Usuarios registrados   = COUNT(clients)
# Alertas                = dias desde ultimo recaudo > limite (diario 7 / semanal 15 / quincenal 30 / mensual 30)
GET {{baseUrl}}/v1/dashboard
Authorization: Bearer {{superadminToken}}

### GET - Dashboard - Deberia fallar con rol admin (403)
GET {{baseUrl}}/v1/dashboard
Authorization: Bearer {{adminToken}}

### GET - Dashboard - Deberia fallar sin token (401)
GET {{baseUrl}}/v1/dashboard


