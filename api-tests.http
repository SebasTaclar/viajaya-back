@baseUrl = http://localhost:7071/api
@superadminToken =
@adminToken =
@viajeroToken =

# ==========================================================
# VIAJAYA - API Tests
# ==========================================================
# Variables:
#   @baseUrl          - URL base del backend (localhost:7071/api)
#   @superadminToken  - JWT de superadmin (dashboard + todo)
#   @adminToken       - JWT de admin (viajeros, recaudos, mensajes; SIN dashboard)
#   @viajeroToken     - JWT de viajero/portal (solo consulta lo propio)
#
# Roles:
#   superadmin - Dashboard KPIs, CRUD viajeros/recaudos, mensajes, usuarios
#   admin      - CRUD viajeros/recaudos, mensajes. Sin dashboard (403)
#   user       - Portal: consulta solo sus datos, saldo y recaudos
#
# Modelo:
#   Client (viajero): name, cedula (unica), phone (obligatorio), ubicacion,
#                     email (opcional), periodicidad (diario|semanal|quincenal|mensual),
#                     isActive, userId (usuario del portal), saldo (calculado)
#   Recaudo: clientId, fecha, valor. La periodicidad vive en el Client.
#
# Respuesta estandar:
#   { "success": true, "data": {...}, "message": "...", "timestamp": "...", "statusCode": 200 }
# ==========================================================


# ==========================================================
# 1. SEED & SETUP
# ==========================================================

### Ejecutar seed (crear superadmin inicial) - Ejecutar una sola vez desde terminal
# npm run db:seed

### Health Check - Verificar conexion a BD
GET {{baseUrl}}/v1/health/db


# ==========================================================
# 2. AUTH
# ==========================================================

### Login - Obtener JWT de SuperAdmin
# @name loginSuperAdmin
POST {{baseUrl}}/v1/login
Content-Type: application/json

{
  "email": "dataor52@gmail.com",
  "password": "esg123"
}

### Login - Obtener JWT de Admin
# @name loginAdmin
# Requiere que el admin exista (ver seccion USERS)
POST {{baseUrl}}/v1/login
Content-Type: application/json

{
  "email": "admin@viajaya.com",
  "password": "Admin123!"
}

### Login Portal viajero - Por cedula + password
# @name loginViajero
# El viajero entra con la cedula y la password asignada al crear el cliente
POST {{baseUrl}}/v1/login
Content-Type: application/json

{
  "cedula": "1234567890",
  "password": "viajero123"
}

### Login - Deberia fallar con cedula inexistente (401)
POST {{baseUrl}}/v1/login
Content-Type: application/json

{
  "cedula": "000000",
  "password": "cualquiera"
}


# ==========================================================
# 3. USERS (gestion de usuarios del panel)
# ==========================================================

### Crear Admin (SOLO SUPERADMIN)
POST {{baseUrl}}/v1/user/create
Content-Type: application/json
Authorization: Bearer {{superadminToken}}

{
  "email": "admin@viajaya.com",
  "name": "Admin Viajaya",
  "password": "Admin123!",
  "role": "admin"
}

### Crear Admin - Deberia fallar si admin intenta crear admin (403)
POST {{baseUrl}}/v1/user/create
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "email": "otro@viajaya.com",
  "name": "Otro Admin",
  "password": "Admin123!",
  "role": "admin"
}

### Listar usuarios (SUPERADMIN o ADMIN)
GET {{baseUrl}}/v1/users
Authorization: Bearer {{superadminToken}}

### Listar usuarios - Deberia fallar con rol user (403)
GET {{baseUrl}}/v1/users
Authorization: Bearer {{viajeroToken}}

### Cambiar password propio (ADMIN)
PATCH {{baseUrl}}/v1/user/change-password
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "newPassword": "Admin123!",
  "userId": "@adminUserId"
}

### Eliminar usuario (SUPERADMIN) - Requiere @targetUserId
DELETE {{baseUrl}}/v1/users/@targetUserId
Authorization: Bearer {{superadminToken}}


# ==========================================================
# 4. CLIENTS / VIAJEROS
# ==========================================================

### POST - Crear viajero (crea cliente + usuario del portal)
# Requiere: @adminToken
# El "password" crea el usuario del portal (login por cedula)
# @name crearViajero
POST {{baseUrl}}/v1/clients
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Juan Perez",
  "cedula": "1234567890",
  "phone": "3001234567",
  "ubicacion": "Bogota",
  "email": "juan@ejemplo.com",
  "periodicidad": "mensual",
  "password": "viajero123"
}

### POST - Crear viajero minimo (sin email ni ubicacion)
POST {{baseUrl}}/v1/clients
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Maria Lopez",
  "cedula": "9876543210",
  "phone": "3109876543",
  "periodicidad": "quincenal",
  "password": "viajero123"
}

### POST - Deberia fallar sin campos obligatorios (400)
# Faltan cedula, phone, periodicidad y password
POST {{baseUrl}}/v1/clients
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Sin Campos"
}

### POST - Deberia fallar con cedula duplicada (409)
POST {{baseUrl}}/v1/clients
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Duplicado",
  "cedula": "1234567890",
  "phone": "3000000000",
  "periodicidad": "diario",
  "password": "viajero123"
}

### POST - Deberia fallar con periodicidad invalida (400)
POST {{baseUrl}}/v1/clients
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Bad Periodicidad",
  "cedula": "5555555555",
  "phone": "3000000001",
  "periodicidad": "trimestral",
  "password": "viajero123"
}

### POST - Deberia fallar con rol user (403)
POST {{baseUrl}}/v1/clients
Content-Type: application/json
Authorization: Bearer {{viajeroToken}}

{
  "name": "No Puede",
  "cedula": "1111111111",
  "phone": "3000000002",
  "periodicidad": "diario",
  "password": "viajero123"
}

### GET - Listar viajeros con saldo (ADMIN)
GET {{baseUrl}}/v1/clients
Authorization: Bearer {{adminToken}}

### GET - Listar viajeros con paginacion y busqueda
GET {{baseUrl}}/v1/clients?search=juan&page=1&limit=10
Authorization: Bearer {{adminToken}}

### GET - Viajero lista solo lo suyo (USER)
GET {{baseUrl}}/v1/clients
Authorization: Bearer {{viajeroToken}}

### GET - Obtener viajero por ID con saldo (ADMIN)
GET {{baseUrl}}/v1/clients/1
Authorization: Bearer {{adminToken}}

### GET - Viajero obtiene otro viajero - Deberia fallar (403)
GET {{baseUrl}}/v1/clients/999
Authorization: Bearer {{viajeroToken}}

### PATCH - Actualizar viajero (cambia password del portal)
# Requiere: @adminToken
PATCH {{baseUrl}}/v1/clients/1
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "phone": "3001112233",
  "periodicidad": "quincenal",
  "password": "nuevapass123"
}

### PATCH - Inactivar viajero (baja logica - visible en frontend)
PATCH {{baseUrl}}/v1/clients/1
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "isActive": false
}

### PATCH - Reactivar viajero
PATCH {{baseUrl}}/v1/clients/1
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "isActive": true
}

### PATCH - Deberia fallar con rol user (403)
PATCH {{baseUrl}}/v1/clients/1
Content-Type: application/json
Authorization: Bearer {{viajeroToken}}

{
  "phone": "0000000000"
}

### DELETE - Eliminar viajero sin recaudos (elimina tambien su usuario)
DELETE {{baseUrl}}/v1/clients/2
Authorization: Bearer {{adminToken}}

### DELETE - Eliminar viajero CON recaudos - Deberia fallar (409)
# Primero debe eliminar todos sus recaudos
# Requiere: @adminToken
DELETE {{baseUrl}}/v1/clients/1
Authorization: Bearer {{adminToken}}

### PATCH - Asignar client a usuario existente (SOLO ADMIN)
PATCH {{baseUrl}}/v1/clients/1/assign-user
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "userId": 2
}


